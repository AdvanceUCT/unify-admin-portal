generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                          String              @id
  name                        String
  email                       String
  emailVerified               Boolean             @default(false)
  image                       String?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt
  role                        String?
  userType                    String              @default("ADMIN")
  banned                      Boolean?            @default(false)
  banReason                   String?
  banExpires                  DateTime?
  sessions                    Session[]
  accounts                    Account[]
  vendorProfile               VendorProfile?
  vendorMemberships           VendorMembership[]
  createdVendorBranches       VendorBranch[]      @relation("VendorBranchCreator")
  createdVendorStaffInvites   VendorStaffInvite[] @relation("VendorStaffInviteCreator")
  initiatedWalletTransactions WalletTransaction[] @relation("WalletTransactionInitiatorUser")
  initiatedPayoutBatches      PayoutBatch[]       @relation("PayoutBatchInitiatorUser")

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model AdminInvite {
  id               String    @id @default(cuid())
  email            String
  name             String
  role             String
  tokenHash        String    @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  revokedByUserId  String?
  createdByUserId  String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([email])
  @@index([expiresAt])
  @@index([createdByUserId])
}

model VendorProfile {
  id                  String                @id @default(cuid())
  userId              String                @unique
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName         String
  serviceCategory     String
  contactPersonName   String?
  contactEmail        String
  website             String?
  description         String?
  verificationUrl     String?
  logoPath            String?
  agentServicePointId String?
  defaultBranchId     String?               @unique
  defaultBranch       VendorBranch?         @relation("VendorDefaultBranch", fields: [defaultBranchId], references: [id], onDelete: SetNull)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  applications        VendorApplication[]
  verifications       VendorVerification[]
  apiCredentials      VendorApiCredential[]
  webhookConfig       VendorWebhookConfig?
  branches            VendorBranch[]        @relation("VendorBranches")
  memberships         VendorMembership[]
  staffInvites        VendorStaffInvite[]
  paymentProfile      VendorPaymentProfile?
  walletAccount       WalletAccount?

  @@map("vendor_profile")
}

model VendorBranch {
  id                  String                           @id @default(cuid())
  vendorProfileId     String
  vendorProfile       VendorProfile                    @relation("VendorBranches", fields: [vendorProfileId], references: [id], onDelete: Cascade)
  name                String
  normalizedName      String
  address             String?
  agentServicePointId String?                          @unique
  verificationUrl     String?
  status              VendorBranchStatus               @default(PROVISIONING)
  active              Boolean                          @default(true)
  createdByUserId     String?
  createdBy           User?                            @relation("VendorBranchCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt
  defaultFor          VendorProfile?                   @relation("VendorDefaultBranch")
  memberships         VendorBranchMembership[]
  inviteAssignments   VendorStaffInviteBranch[]
  verifications       VendorVerification[]
  paymentApplications VendorBranchPaymentApplication[]
  paymentAcceptance   VendorBranchPaymentAcceptance?
  walletTransactions  WalletTransaction[]

  @@unique([vendorProfileId, normalizedName])
  @@index([vendorProfileId, active])
  @@map("vendor_branch")
}

enum VendorBranchStatus {
  PROVISIONING
  ACTIVE
  DISABLED
  PROVISIONING_FAILED
}

model VendorMembership {
  id              String                   @id @default(cuid())
  vendorProfileId String
  vendorProfile   VendorProfile            @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  userId          String
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            VendorMembershipRole
  active          Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  branches        VendorBranchMembership[]

  @@unique([vendorProfileId, userId])
  @@index([userId, active])
  @@map("vendor_membership")
}

enum VendorMembershipRole {
  OWNER
  STAFF
}

model VendorBranchMembership {
  vendorMembershipId String
  vendorMembership   VendorMembership @relation(fields: [vendorMembershipId], references: [id], onDelete: Cascade)
  vendorBranchId     String
  vendorBranch       VendorBranch     @relation(fields: [vendorBranchId], references: [id], onDelete: Cascade)
  createdAt          DateTime         @default(now())

  @@id([vendorMembershipId, vendorBranchId])
  @@index([vendorBranchId])
  @@map("vendor_branch_membership")
}

model VendorStaffInvite {
  id               String                    @id @default(cuid())
  vendorProfileId  String
  vendorProfile    VendorProfile             @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  email            String
  name             String
  tokenHash        String                    @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  revokedByUserId  String?
  createdByUserId  String
  createdBy        User                      @relation("VendorStaffInviteCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  branches         VendorStaffInviteBranch[]

  @@index([vendorProfileId, email])
  @@index([expiresAt])
  @@map("vendor_staff_invite")
}

model VendorStaffInviteBranch {
  vendorStaffInviteId String
  vendorStaffInvite   VendorStaffInvite @relation(fields: [vendorStaffInviteId], references: [id], onDelete: Cascade)
  vendorBranchId      String
  vendorBranch        VendorBranch      @relation(fields: [vendorBranchId], references: [id], onDelete: Cascade)

  @@id([vendorStaffInviteId, vendorBranchId])
  @@index([vendorBranchId])
  @@map("vendor_staff_invite_branch")
}

model VendorApplication {
  id                         String                  @id @default(cuid())
  vendorProfileId            String
  vendorProfile              VendorProfile           @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  status                     VendorApplicationStatus @default(DRAFT)
  justification              String?
  companyRegistrationNumber  String?
  // Original review decision fields — immutable after approval/rejection
  reviewedByUserId           String?
  reviewedAt                 DateTime?
  reviewNotes                String?
  // Revocation fields — populated only when status transitions to REVOKED
  revokedByUserId            String?
  revokedAt                  DateTime?
  revokedNotes               String?
  viewedByAdminAt            DateTime?
  // Immutable snapshot of vendor profile at time of submission
  snapshotCompanyName        String?
  snapshotServiceCategory    String?
  snapshotContactEmail       String?
  snapshotContactPersonName  String?
  snapshotWebsite            String?
  // Step 1 — Organisation Information
  tradingName                String?
  organisationType           String?
  physicalAddress            String?
  postalAddress              String?
  // Step 2 — Authorised Representative
  contactJobTitle            String?
  contactPhone               String?
  contactEmployeeNumber      String?
  preferredContactMethod     String?
  // Step 3 — Verification Requirements
  verificationReasons        String[]                @default([])
  otherVerificationReason    String?
  additionalInfo             String?
  // Step 4 — Supporting Documents (Supabase Storage paths)
  docRegistrationCertificate String?
  docProofOfAddress          String?
  docRepresentativeId        String?
  docLetterOfAuthorisation   String?
  docTaxCompliance           String?
  docBusinessLicence         String?
  // Step 5 — Declaration
  declarationAccepted        Boolean?
  declarationAcceptedAt      DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  @@unique([vendorProfileId], map: "vendor_application_one_active_per_profile", where: raw("\"status\" IN ('DRAFT', 'PENDING', 'APPROVED')"))
  @@index([vendorProfileId])
  @@index([status])
  @@map("vendor_application")
}

enum VendorApplicationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

model VendorVerification {
  id                     String                   @id @default(cuid())
  vendorProfileId        String
  vendorProfile          VendorProfile            @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  branchId               String?
  branch                 VendorBranch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  verificationRequestId  String?                  @unique
  checkoutId             String?
  eventId                String?                  @unique
  servicePointId         String?
  servicePointName       String?
  status                 VendorVerificationStatus @default(PENDING)
  isVerified             Boolean?
  failureCode            String?
  attributes             Json?
  schemaId               String?
  credentialDefinitionId String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  completedAt            DateTime?
  expiresAt              DateTime?
  deliveries             VendorWebhookDelivery[]

  @@unique([vendorProfileId, checkoutId])
  @@index([vendorProfileId])
  @@index([branchId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@map("vendor_verification")
}

model VendorApiCredential {
  id              String        @id @default(cuid())
  vendorProfileId String
  vendorProfile   VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  name            String
  keyPrefix       String        @unique
  keyHash         String        @unique
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([vendorProfileId])
  @@map("vendor_api_credential")
}

model VendorWebhookConfig {
  id                      String        @id @default(cuid())
  vendorProfileId         String        @unique
  vendorProfile           VendorProfile @relation(fields: [vendorProfileId], references: [id], onDelete: Cascade)
  url                     String
  signingSecretCiphertext String
  enabled                 Boolean       @default(true)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@map("vendor_webhook_config")
}

model VendorWebhookDelivery {
  id                   String                      @id @default(cuid())
  vendorVerificationId String
  vendorVerification   VendorVerification          @relation(fields: [vendorVerificationId], references: [id], onDelete: Cascade)
  attemptNumber        Int
  status               VendorWebhookDeliveryStatus
  responseStatus       Int?
  errorMessage         String?
  attemptedAt          DateTime                    @default(now())

  @@unique([vendorVerificationId, attemptNumber])
  @@index([status])
  @@map("vendor_webhook_delivery")
}

enum VendorWebhookDeliveryStatus {
  DELIVERED
  FAILED
}

enum VendorVerificationStatus {
  PENDING
  APPROVED
  DECLINED
  EXPIRED
  FAILED
}

model Student {
  id            String         @id @default(cuid())
  studentNumber String         @unique
  email         String
  firstName     String
  lastName      String
  faculty       String?
  programme     String?
  attributes    Json           @default("{}")
  source        String         @default("csv")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  walletAccount WalletAccount?

  @@index([faculty])
  @@index([programme])
  @@map("student")
}

model UniversityProfile {
  id                            String                  @id @default(cuid())
  name                          String
  abbreviation                  String
  logoPath                      String?
  contactEmail                  String
  websiteUrl                    String?
  issuerDid                     String?
  setupStatus                   SetupStatus             @default(PENDING)
  setupCompletedAt              DateTime?
  defaultCredentialValidityDays Int                     @default(365)
  renewalCadenceMonths          Int                     @default(12)
  paymentsEnabled               Boolean                 @default(false)
  paymentRefundWindowSeconds    Int                     @default(600)
  paymentSettlementDelaySeconds Int                     @default(600)
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  credentialSchemas             CredentialSchema[]
  importMapping                 ImportMapping?
  importRuns                    ImportRun[]
  customFieldDefinitions        CustomFieldDefinition[]

  @@map("university_profile")
}

model WalletAccount {
  id                    String                @id @default(cuid())
  type                  WalletAccountType
  status                WalletAccountStatus   @default(ACTIVE)
  currency              String                @default("ZAR")
  studentId             String?               @unique
  student               Student?              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  vendorProfileId       String?               @unique
  vendorProfile         VendorProfile?        @relation(fields: [vendorProfileId], references: [id], onDelete: Restrict)
  systemCode            String?               @unique
  createdAt             DateTime              @default(now())
  closedAt              DateTime?
  balance               WalletAccountBalance?
  entries               LedgerEntry[]
  initiatedTransactions WalletTransaction[]   @relation("WalletTransactionInitiator")

  @@index([type, status])
  @@map("wallet_account")
}

model WalletAccountBalance {
  accountId          String        @id
  account            WalletAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  postedBalanceMinor BigInt        @default(0)
  version            BigInt        @default(0)
  updatedAt          DateTime      @updatedAt

  @@map("wallet_account_balance")
}

model WalletTransaction {
  id                     String                  @id @default(cuid())
  type                   WalletTransactionType
  status                 WalletTransactionStatus @default(PENDING)
  amountMinor            BigInt
  currency               String                  @default("ZAR")
  initiatorAccountId     String?
  initiatorAccount       WalletAccount?          @relation("WalletTransactionInitiator", fields: [initiatorAccountId], references: [id], onDelete: Restrict)
  initiatedByUserId      String?
  initiatedByUser        User?                   @relation("WalletTransactionInitiatorUser", fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  vendorBranchId         String?
  vendorBranch           VendorBranch?           @relation(fields: [vendorBranchId], references: [id], onDelete: Restrict)
  linkedTransactionId    String?
  linkedTransaction      WalletTransaction?      @relation("WalletTransactionLinks", fields: [linkedTransactionId], references: [id], onDelete: Restrict)
  linkedTransactions     WalletTransaction[]     @relation("WalletTransactionLinks")
  idempotencyKey         String?
  reference              String?
  paymentProvider        String?
  providerPaymentId      String?
  providerPayerReference String?
  refundableUntil        DateTime?
  availableForPayoutAt   DateTime?
  completedAt            DateTime?
  failedAt               DateTime?
  failureCode            String?
  createdAt              DateTime                @default(now())
  entries                LedgerEntry[]
  gatewayEvents          PaymentGatewayEvent[]
  payoutBatch            PayoutBatch?

  @@unique([initiatorAccountId, type, idempotencyKey], map: "wallet_transaction_idempotency_key", where: raw("\"idempotencyKey\" IS NOT NULL"))
  @@unique([paymentProvider, providerPaymentId], map: "wallet_transaction_provider_payment_key", where: raw("\"providerPaymentId\" IS NOT NULL"))
  @@index([type, status, createdAt])
  @@index([vendorBranchId, createdAt])
  @@index([linkedTransactionId])
  @@index([initiatedByUserId, createdAt])
  @@map("wallet_transaction")
}

model LedgerEntry {
  id                  String            @id @default(cuid())
  walletTransactionId String
  walletTransaction   WalletTransaction @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)
  accountId           String
  account             WalletAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  sequence            Int
  direction           LedgerDirection
  amountMinor         BigInt
  currency            String
  createdAt           DateTime          @default(now())

  @@unique([walletTransactionId, sequence])
  @@unique([walletTransactionId, accountId])
  @@index([accountId, createdAt, id])
  @@map("ledger_entry")
}

model VendorPaymentProfile {
  id                          String                     @id @default(cuid())
  vendorProfileId             String                     @unique
  vendorProfile               VendorProfile              @relation(fields: [vendorProfileId], references: [id], onDelete: Restrict)
  status                      VendorPaymentProfileStatus @default(PENDING)
  payoutProvider              String?
  payoutDestinationReference  String?
  payoutDestinationCiphertext String?
  approvedAt                  DateTime?
  approvedByUserId            String?
  suspendedAt                 DateTime?
  suspensionReason            String?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  payoutBatches               PayoutBatch[]

  @@index([status])
  @@map("vendor_payment_profile")
}

model VendorBranchPaymentApplication {
  id                 String                         @id @default(cuid())
  vendorBranchId     String
  vendorBranch       VendorBranch                   @relation(fields: [vendorBranchId], references: [id], onDelete: Restrict)
  status             BranchPaymentApplicationStatus @default(DRAFT)
  submittedAt        DateTime?
  reviewedAt         DateTime?
  reviewedByUserId   String?
  reviewNotes        String?
  withdrawnAt        DateTime?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  approvedAcceptance VendorBranchPaymentAcceptance? @relation("ApprovedBranchPaymentApplication")

  @@unique([id, vendorBranchId])
  @@unique([vendorBranchId], map: "vendor_branch_payment_application_one_active", where: raw("\"status\" IN ('DRAFT', 'PENDING', 'APPROVED')"))
  @@index([vendorBranchId, createdAt])
  @@index([status])
  @@map("vendor_branch_payment_application")
}

model VendorBranchPaymentAcceptance {
  id                    String                         @id @default(cuid())
  vendorBranchId        String                         @unique
  vendorBranch          VendorBranch                   @relation(fields: [vendorBranchId], references: [id], onDelete: Restrict)
  approvedApplicationId String                         @unique
  approvedApplication   VendorBranchPaymentApplication @relation("ApprovedBranchPaymentApplication", fields: [approvedApplicationId, vendorBranchId], references: [id, vendorBranchId], onDelete: Restrict)
  status                BranchPaymentAcceptanceStatus  @default(ACTIVE)
  qrIdentifier          String                         @unique
  approvedAt            DateTime
  suspendedAt           DateTime?
  suspensionReason      String?
  createdAt             DateTime                       @default(now())
  updatedAt             DateTime                       @updatedAt

  @@unique([approvedApplicationId, vendorBranchId])
  @@index([status])
  @@map("vendor_branch_payment_acceptance")
}

model PaymentGatewayEvent {
  id                  String             @id @default(cuid())
  provider            String
  externalEventId     String
  eventType           String
  payloadHash         String
  walletTransactionId String?
  walletTransaction   WalletTransaction? @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)
  receivedAt          DateTime           @default(now())
  processedAt         DateTime?
  processingError     String?

  @@unique([provider, externalEventId])
  @@index([walletTransactionId])
  @@map("payment_gateway_event")
}

model PayoutBatch {
  id                         String                 @id @default(cuid())
  vendorPaymentProfileId     String
  vendorPaymentProfile       VendorPaymentProfile   @relation(fields: [vendorPaymentProfileId], references: [id], onDelete: Restrict)
  status                     PayoutBatchStatus      @default(PENDING)
  amountMinor                BigInt
  currency                   String                 @default("ZAR")
  cutoffAt                   DateTime
  provider                   String
  providerIdempotencyKey     String                 @unique
  providerPayoutId           String?
  payoutDestinationReference String
  initiationSource           PayoutInitiationSource @default(SCHEDULED)
  initiatedByUserId          String?
  initiatedByUser            User?                  @relation("PayoutBatchInitiatorUser", fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  payoutTransactionId        String?                @unique
  payoutTransaction          WalletTransaction?     @relation(fields: [payoutTransactionId], references: [id], onDelete: Restrict)
  attemptCount               Int                    @default(0)
  lastAttemptAt              DateTime?
  completedAt                DateTime?
  failureCode                String?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt

  @@unique([provider, providerPayoutId], map: "payout_batch_provider_payout_key", where: raw("\"providerPayoutId\" IS NOT NULL"))
  @@index([vendorPaymentProfileId, status])
  @@index([initiatedByUserId, createdAt])
  @@map("payout_batch")
}

enum WalletAccountType {
  STUDENT
  VENDOR
  SYSTEM
}

enum WalletAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum WalletTransactionType {
  TOPUP
  SPEND
  REFUND
  PAYOUT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum VendorPaymentProfileStatus {
  PENDING
  APPROVED
  SUSPENDED
  CLOSED
}

enum BranchPaymentApplicationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum BranchPaymentAcceptanceStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum PayoutBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REQUIRES_RECONCILIATION
}

enum PayoutInitiationSource {
  SCHEDULED
  MANUAL
}

model ImportMapping {
  id                  String            @id @default(cuid())
  universityProfileId String            @unique
  universityProfile   UniversityProfile @relation(fields: [universityProfileId], references: [id])
  columnMap           Json
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("import_mapping")
}

/// Admin-defined per-university custom fields available as CSV import mapping
/// targets, independent of `CredentialSchema.schemaAttributes`. Soft-deleted
/// (`removedAt`) rather than hard-deleted on removal — historical `Student.attributes`
/// data under a removed field's key is never touched, only future imports stop
/// offering/populating it. Re-adding a previously removed key reactivates the
/// same row rather than creating an ambiguous duplicate.
model CustomFieldDefinition {
  id                  String            @id @default(cuid())
  universityProfileId String
  universityProfile   UniversityProfile @relation(fields: [universityProfileId], references: [id])
  key                 String
  label               String
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  removedAt           DateTime?

  @@unique([universityProfileId, key], map: "custom_field_definition_active_key", where: raw("\"removedAt\" IS NULL"))
  @@index([universityProfileId])
  @@map("custom_field_definition")
}

/// Pending CSV import previews for a university. A commit must name the exact
/// run to apply, so concurrent admins cannot overwrite each other's previews.
model ImportRun {
  id                  String            @id @default(cuid())
  universityProfileId String
  universityProfile   UniversityProfile @relation(fields: [universityProfileId], references: [id])
  filename            String
  mappingSnapshot     Json
  createdAt           DateTime          @default(now())
  rows                ImportRow[]

  @@index([universityProfileId])
  @@map("import_run")
}

model ImportRow {
  id            String          @id @default(cuid())
  importRunId   String
  importRun     ImportRun       @relation(fields: [importRunId], references: [id], onDelete: Cascade)
  rowNumber     Int?
  studentNumber String?
  status        ImportRowStatus
  mappedData    Json?
  errors        Json?
  diff          Json?
  createdAt     DateTime        @default(now())

  @@index([importRunId])
  @@index([status])
  @@map("import_row")
}

enum ImportRowStatus {
  NEW
  UPDATED
  UNCHANGED
  MISSING
  ERROR
}

model CredentialSchema {
  id                             String                 @id @default(cuid())
  universityProfileId            String
  universityProfile              UniversityProfile      @relation(fields: [universityProfileId], references: [id])
  schemaName                     String
  schemaVersion                  String
  schemaAttributes               String[]
  schemaId                       String?
  credentialDefinitionId         String?
  revocationRegistryDefinitionId String?
  status                         CredentialSchemaStatus @default(ACTIVE)
  isActive                       Boolean                @default(true)
  activatedAt                    DateTime?
  publishedAt                    DateTime?
  retiredAt                      DateTime?
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt

  @@unique([universityProfileId, schemaName, schemaVersion])
  @@index([universityProfileId])
  @@index([universityProfileId, isActive])
  @@index([universityProfileId, status])
  @@map("credential_schema")
}

model CredentialIssuance {
  id                             String                     @id @default(cuid())
  studentId                      String
  credentialDefinitionId         String
  schemaVersion                  String?
  credentialExchangeId           String?                    @unique
  revocationRegistryDefinitionId String?
  credentialRevocationId         String?
  activationId                   String?
  activationUrl                  String?
  activationExpiresAt            DateTime?
  email                          String?
  deliveryStatus                 CredentialDeliveryStatus   @default(PENDING)
  status                         CredentialIssuanceStatus
  lifecycleStatus                CredentialLifecycleStatus?
  lifecycleStatusUpdatedAt       DateTime?
  lifecycleReason                String?
  renewalStatus                  CredentialRenewalStatus    @default(NONE)
  renewalRequestedAt             DateTime?
  renewalCompletedAt             DateTime?
  renewalFailureReason           String?
  renewedFromIssuanceId          String?
  renewedIntoIssuanceId          String?
  failureReason                  String?
  issuedAt                       DateTime?
  revokedAt                      DateTime?
  suspendedAt                    DateTime?
  reactivatedAt                  DateTime?
  credentialExpiresAt            DateTime?
  createdAt                      DateTime                   @default(now())
  updatedAt                      DateTime                   @updatedAt
  batchItem                      BatchIssuanceItem?

  @@unique([revocationRegistryDefinitionId, credentialRevocationId])
  @@index([studentId])
  @@index([credentialDefinitionId])
  @@index([revocationRegistryDefinitionId])
  @@index([status])
  @@index([lifecycleStatus])
  @@index([renewalStatus])
  @@index([renewedFromIssuanceId])
  @@index([renewedIntoIssuanceId])
  @@index([createdAt])
  @@map("credential_issuance")
}

model CredentialEventLog {
  id                     String                    @id @default(cuid())
  eventId                String                    @unique
  type                   CredentialEventType
  credentialExchangeId   String
  credentialDefinitionId String?
  previousState          String?
  state                  String
  status                 CredentialIssuanceStatus?
  payload                Json
  occurredAt             DateTime
  receivedAt             DateTime                  @default(now())

  @@index([credentialExchangeId])
  @@index([credentialDefinitionId])
  @@index([status])
  @@index([occurredAt])
  @@map("credential_event_log")
}

model CredentialAuditLog {
  id                     String                    @id @default(cuid())
  eventId                String?                   @unique
  action                 CredentialAuditAction
  actorId                String?
  studentId              String
  credentialDefinitionId String
  credentialExchangeId   String?
  credentialIssuanceId   String?
  batchId                String?
  batchItemId            String?
  deliveryStatus         CredentialDeliveryStatus?
  message                String?
  metadata               Json?
  occurredAt             DateTime                  @default(now())
  createdAt              DateTime                  @default(now())

  @@index([actorId])
  @@index([studentId])
  @@index([credentialDefinitionId])
  @@index([credentialExchangeId])
  @@index([credentialIssuanceId])
  @@index([action])
  @@index([action, credentialExchangeId])
  @@index([occurredAt])
  @@map("credential_audit_log")
}

model BatchIssuanceRun {
  id             String                 @id @default(cuid())
  batchId        String                 @unique
  actorId        String?
  cohortId       String
  filters        Json
  status         BatchIssuanceRunStatus @default(PREVIEWED)
  requestedCount Int                    @default(0)
  eligibleCount  Int                    @default(0)
  skippedCount   Int                    @default(0)
  issuedCount    Int                    @default(0)
  failedCount    Int                    @default(0)
  activatedCount Int                    @default(0)
  queuedAt       DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  items          BatchIssuanceItem[]

  @@index([actorId])
  @@index([status])
  @@index([createdAt])
  @@map("batch_issuance_run")
}

model BatchIssuanceItem {
  id                   String                  @id @default(cuid())
  batchRunId           String
  batchRun             BatchIssuanceRun        @relation(fields: [batchRunId], references: [id], onDelete: Cascade)
  studentId            String
  status               BatchIssuanceItemStatus @default(PENDING)
  skipReason           String?
  failureReason        String?
  credentialIssuanceId String?                 @unique
  credentialIssuance   CredentialIssuance?     @relation(fields: [credentialIssuanceId], references: [id], onDelete: SetNull)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([batchRunId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("batch_issuance_item")
}

enum BatchIssuanceRunStatus {
  DRAFT
  PREVIEWED
  QUEUED
  PROCESSING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
  CANCELLED
}

enum BatchIssuanceItemStatus {
  ELIGIBLE
  SKIPPED
  PENDING
  OFFER_CREATED
  DELIVERED
  DELIVERY_FAILED
  ACTIVATED
  FAILED
}

enum CredentialIssuanceStatus {
  OFFER_SENT
  ACCEPTED
  ISSUED
  FAILED
  REVOKED
}

enum CredentialLifecycleStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

enum CredentialSchemaStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum CredentialRenewalStatus {
  NONE
  PENDING
  COMPLETED
  FAILED
  SKIPPED
}

enum CredentialDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum CredentialEventType {
  CREDENTIAL_STATE_CHANGED
}

enum CredentialAuditAction {
  OFFER_SENT
  OFFER_DELIVERY_FAILED
  REISSUE_REQUESTED
  REVOCATION_REQUESTED
  REVOCATION_COMPLETED
  CREDENTIAL_LIFECYCLE_ACTIVATED
  CREDENTIAL_SUSPENDED
  CREDENTIAL_REACTIVATED
  CREDENTIAL_REVOKED
  CREDENTIAL_EXPIRED
  CREDENTIAL_RENEWAL_REQUESTED
  CREDENTIAL_RENEWAL_OFFER_CREATED
  CREDENTIAL_RENEWAL_FAILED
}

enum SetupStatus {
  PENDING
  DID_CREATED
  SCHEMA_CREATED
  COMPLETE
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  targetType String?
  targetId   String?
  meta       Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

