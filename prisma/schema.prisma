generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model AdminInvite {
  id               String    @id @default(cuid())
  email            String
  name             String
  role             String
  tokenHash        String    @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  acceptedByUserId String?
  revokedAt        DateTime?
  revokedByUserId  String?
  createdByUserId  String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([email])
  @@index([expiresAt])
  @@index([createdByUserId])
}

model UniversityProfile {
  id                 String             @id @default(cuid())
  name               String
  abbreviation       String
  logoUrl            String?
  contactEmail       String
  issuerDid          String?
  setupStatus        SetupStatus        @default(PENDING)
  setupCompletedAt   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  credentialSchemas  CredentialSchema[]

  @@map("university_profile")
}

model CredentialSchema {
  id                             String            @id @default(cuid())
  universityProfileId            String
  universityProfile              UniversityProfile @relation(fields: [universityProfileId], references: [id])
  schemaName                     String
  schemaVersion                  String
  schemaAttributes               String[]
  schemaId                       String?
  credentialDefinitionId         String?
  revocationRegistryDefinitionId String?
  isActive                       Boolean           @default(true)
  createdAt                      DateTime          @default(now())
  updatedAt                      DateTime          @updatedAt

  @@index([universityProfileId])
  @@map("credential_schema")
}

model CredentialIssuance {
  id                     String                     @id @default(cuid())
  studentId              String
  credentialDefinitionId String
  credentialExchangeId   String?                    @unique
  activationId           String?
  activationUrl          String?
  activationExpiresAt    DateTime?
  email                  String?
  deliveryStatus         CredentialDeliveryStatus   @default(PENDING)
  status                 CredentialIssuanceStatus
  failureReason          String?
  issuedAt               DateTime?
  revokedAt              DateTime?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  batchItem              BatchIssuanceItem?

  @@index([studentId])
  @@index([credentialDefinitionId])
  @@index([status])
  @@index([createdAt])
  @@map("credential_issuance")
}

model CredentialEventLog {
  id                     String                    @id @default(cuid())
  eventId                String                    @unique
  type                   CredentialEventType
  credentialExchangeId   String
  credentialDefinitionId String?
  previousState          String?
  state                  String
  status                 CredentialIssuanceStatus?
  payload                Json
  occurredAt             DateTime
  receivedAt             DateTime                  @default(now())

  @@index([credentialExchangeId])
  @@index([credentialDefinitionId])
  @@index([status])
  @@index([occurredAt])
  @@map("credential_event_log")
}

model CredentialAuditLog {
  id                     String                    @id @default(cuid())
  action                 CredentialAuditAction
  actorId                String?
  studentId              String
  credentialDefinitionId String
  credentialExchangeId   String?
  credentialIssuanceId   String?
  batchId                String?
  batchItemId            String?
  deliveryStatus         CredentialDeliveryStatus?
  message                String?
  metadata               Json?
  occurredAt             DateTime                  @default(now())
  createdAt              DateTime                  @default(now())

  @@unique([action, credentialExchangeId])
  @@index([actorId])
  @@index([studentId])
  @@index([credentialDefinitionId])
  @@index([credentialExchangeId])
  @@index([credentialIssuanceId])
  @@index([action])
  @@index([occurredAt])
  @@map("credential_audit_log")
}

model BatchIssuanceRun {
  id             String                  @id @default(cuid())
  batchId        String                  @unique
  actorId        String?
  cohortId       String
  filters        Json
  status         BatchIssuanceRunStatus  @default(PREVIEWED)
  requestedCount Int                     @default(0)
  eligibleCount  Int                     @default(0)
  skippedCount   Int                     @default(0)
  issuedCount    Int                     @default(0)
  failedCount    Int                     @default(0)
  activatedCount Int                     @default(0)
  queuedAt       DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  items          BatchIssuanceItem[]

  @@index([actorId])
  @@index([status])
  @@index([createdAt])
  @@map("batch_issuance_run")
}

model BatchIssuanceItem {
  id                   String                     @id @default(cuid())
  batchRunId           String
  batchRun             BatchIssuanceRun           @relation(fields: [batchRunId], references: [id], onDelete: Cascade)
  studentId            String
  status               BatchIssuanceItemStatus    @default(PENDING)
  skipReason           String?
  failureReason        String?
  credentialIssuanceId String?                    @unique
  credentialIssuance   CredentialIssuance?        @relation(fields: [credentialIssuanceId], references: [id], onDelete: SetNull)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@unique([batchRunId, studentId])
  @@index([studentId])
  @@index([status])
  @@map("batch_issuance_item")
}

enum BatchIssuanceRunStatus {
  DRAFT
  PREVIEWED
  QUEUED
  PROCESSING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
  CANCELLED
}

enum BatchIssuanceItemStatus {
  ELIGIBLE
  SKIPPED
  PENDING
  OFFER_CREATED
  DELIVERED
  DELIVERY_FAILED
  ACTIVATED
  FAILED
}

enum CredentialIssuanceStatus {
  OFFER_SENT
  ACCEPTED
  ISSUED
  FAILED
  REVOKED
}

enum CredentialDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum CredentialEventType {
  CREDENTIAL_STATE_CHANGED
}

enum CredentialAuditAction {
  OFFER_SENT
  OFFER_DELIVERY_FAILED
  REISSUE_REQUESTED
  REVOCATION_REQUESTED
  REVOCATION_COMPLETED
}

enum SetupStatus {
  PENDING
  DID_CREATED
  SCHEMA_CREATED
  COMPLETE
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  targetType String?
  targetId   String?
  meta       Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  INVITE_CREATED
  INVITE_ACCEPTED
  INVITE_REVOKED
  INVITE_EXPIRED
  USER_DEACTIVATED
  USER_REACTIVATED
  USER_ROLE_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  SESSION_REVOKED
  BATCH_ISSUANCE_CREATED
  BATCH_ISSUANCE_COMPLETED
  BATCH_ISSUANCE_RETRIED
}
