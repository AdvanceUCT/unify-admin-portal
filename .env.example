DATABASE_URL="postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.project-ref:password@db.project-ref.supabase.co:5432/postgres"

BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_NAME="Initial Super Admin"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-strong-bootstrap-password"

ADMIN_INVITE_TTL_HOURS="24"
AUTH_EMAIL_FROM="UNIFY Admin <admin@example.com>"

NEXT_PUBLIC_API_BASE_URL="mock://unify-admin"

# Optional Turso local-cache DB. Leave blank to use the primary Postgres/Prisma path.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Setup wizard bypass (for development/testing) - set to 'true' to skip the setup wizard and assume everything is already set up (may cause certain functionality to break if the expected setup is not actually in place)
SETUP_BYPASS="false"

# Agent Service
AGENT_SERVICE_URL="http://localhost:3002"
AGENT_API_KEY="dev-agent-api-key"

# Credential activation email delivery
# For a real MVP email, set RESEND_API_KEY and keep delivery mode as resend.
# For local copy/paste testing without sending email, set CREDENTIAL_EMAIL_DELIVERY_MODE="console".
RESEND_API_KEY=""
CREDENTIAL_EMAIL_FROM="UNIFY Credentials <onboarding@resend.dev>"
CREDENTIAL_EMAIL_DELIVERY_MODE="resend"
