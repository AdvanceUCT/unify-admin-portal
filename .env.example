# Copy this file to .env and fill in the values.
# For production, set these in the Vercel dashboard — don't commit real secrets.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres.project-ref:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.project-ref:password@db.project-ref.supabase.co:5432/postgres" # Used by Prisma for migrations (bypasses pgBouncer)

# ─── App URLs ─────────────────────────────────────────────────────────────────
BETTER_AUTH_URL="http://localhost:3000"   # Base URL used by BetterAuth for callbacks
APP_URL="http://localhost:3000"           # Public URL of the admin portal
ACTIVATION_PUBLIC_BASE_URL="http://localhost:3000" # Base URL embedded in credential activation links sent to students

# ─── Auth ─────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET="replace-with-a-strong-secret-key" # Used to sign sessions — generate with: openssl rand -base64 32
ANDROID_APP_LINK_SHA256_CERT_FINGERPRINTS=""          # SHA-256 cert fingerprint for Android App Links verification

# ─── Bootstrap Admin ──────────────────────────────────────────────────────────
# Used only on first run to seed the initial super admin account.
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_NAME="Initial Super Admin"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-strong-bootstrap-password"

# ─── Invites & Email ──────────────────────────────────────────────────────────
ADMIN_INVITE_TTL_HOURS="24"                          # How long an invite link stays valid
AUTH_EMAIL_FROM="UNIFY Admin <admin@example.com>"    # From address for auth emails (password reset, invites)

# ─── Agent Service ────────────────────────────────────────────────────────────
AGENT_SERVICE_URL="http://localhost:3002"
AGENT_API_KEY="dev-agent-api-key"
AGENT_HEALTH_TIMEOUT_MS="5000"     # Health-check timeout
AGENT_STANDARD_TIMEOUT_MS="15000"  # DID, lifecycle, verifier, and wallet activation calls
AGENT_LONG_TIMEOUT_MS="60000"      # Schema setup and batch activation-link issuance
WEBHOOK_SIGNING_SECRET="replace-with-the-same-secret-used-by-the-agent-service" # Must match the secret configured on the agent

# ─── Credential Email ─────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
CREDENTIAL_EMAIL_FROM="UNIFY Credentials <onboarding@resend.dev>"
CREDENTIAL_EMAIL_DELIVERY_MODE="resend" # Set to "resend" to send real emails, or "log" to print them to the console instead

# ─── Document Storage (Supabase Storage) ─────────────────────────────────────
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ─── Dev / Testing ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL="mock://unify-admin"
SETUP_BYPASS="false" # Set to "true" to skip the setup wizard in dev — may break things if the DB isn't actually set up
